# Template for the local stack's environment.
#
# You do not normally copy this by hand: ./run.sh and ./dev.sh call
# scripts/prepare-env.sh, which generates a .env with fresh random values the
# first time they run. Copy it only if you want to pin the values yourself.
#
#   cp .env.example .env   &&   fill in every CHANGE_ME
#
# .env is gitignored. Nothing in it is a real credential - every value below
# keys something that exists only inside the test stack - but they are still
# generated per machine rather than checked in, so that no example value can
# ever end up protecting something real.

# --- Application URL ---------------------------------------------------------
# The application's fixed address on the compose network, pinned in
# docker-compose.yml. Baked into the client bundle at build time, so changing
# it needs a rebuild - and it must match the address the browsers use.
APP_URL=http://172.19.0.9:3000
APP_WS_URL=ws://172.19.0.9:3000/ws

# --- Database ----------------------------------------------------------------
POSTGRES_USER=artra
POSTGRES_DB=artra
POSTGRES_PASSWORD=CHANGE_ME

# --- Fixture accounts --------------------------------------------------------
# The seeded accounts in stack/db/init/02-seed.sql. stack/app/seed-users.mjs
# hashes this password with the application's own Argon2 parameters on every
# start, so changing it here is enough.
SEED_STUDENT_EMAIL=student@artra.test
SEED_USER_PASSWORD=CHANGE_ME

# --- Application secrets -----------------------------------------------------
# Keys for Argon2, the verification-code HMAC, the reset-token HMAC and the
# device-fingerprint HMAC. Any random value works; they must simply stay stable
# for the life of a stack, or existing hashes stop verifying.
ARGON_SECRET=CHANGE_ME
CODE_PEPPER=CHANGE_ME
PASSWORD_RESET_SECRET=CHANGE_ME
SIGNATURE_SECRET=CHANGE_ME
IP_SECRET=CHANGE_ME

# --- Email -------------------------------------------------------------------
# The stack always sends through Mailpit (EMAIL_PROVIDER=smtp is hard-coded in
# docker-compose.yml), so no provider credential is needed to run the suite.
# These two only shape the From and Reply-To headers of the captured mail.
EMAIL_FROM="Artra <no-reply@artra.test>"
EMAIL_REPLY_TO=support@artra.test

# RESEND_API_KEY is deliberately NOT here. It belongs to the application's own
# production environment, not to the test stack - see docs/EMAIL.md.

# --- Public URL (optional) ---------------------------------------------------
# Only for `./run.sh public=on` / `./dev.sh public=on`, which serves the
# application over HTTPS on a public domain instead of at its container address.
# The suite does not need this; Google's sign-in button does, because Google
# will not render it on an origin it cannot recognise, and it only recognises
# HTTPS ones.
#
# In that mode APP_URL and APP_WS_URL above are ignored and derived from
# NGROK_DOMAIN instead, and the application image is rebuilt to match.
#
#   NGROK_DOMAIN      a reserved ngrok domain, no scheme and no trailing slash.
#                     Reserve one (free) at https://dashboard.ngrok.com/domains
#   NGROK_AUTHTOKEN   https://dashboard.ngrok.com/get-started/your-authtoken
#   GOOGLE_CLIENT_ID  the OAuth client ID. Public, not a secret: it is rendered
#                     into the sign-in button. In the Google Cloud console the
#                     same client must list
#                       https://$NGROK_DOMAIN                    as an authorised
#                                                                JavaScript origin
#                       https://$NGROK_DOMAIN/api/auth/google    as an authorised
#                                                                redirect URI
NGROK_DOMAIN=
NGROK_AUTHTOKEN=
GOOGLE_CLIENT_ID=
