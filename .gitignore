# Build output
target/

# Run artifacts: reports, screenshots, logs and recordings are archived here
runs/

# Session recordings, before run.sh files them under runs/
videos/

# The grid's effective config for a run, written from config.toml by the
# startup scripts. config.toml itself is tracked.
config.generated.toml

# Generated per machine by scripts/prepare-env.sh. Holds the throwaway
# secrets the local stack keys its hashes with - never committed.
# .env.example is the tracked template.
.env
*.local

# Staged copy of the application under test (see scripts/prepare-app.sh)
.artra-build/
.artra-src/

# Editors / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
