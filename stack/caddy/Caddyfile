# HTTPS in front of Artra.
#
# Not decoration: Artra marks its session and verification cookies Secure, and
# a browser only accepts those over HTTPS or from localhost. The browsers here
# live in their own containers and reach the app by its network name, which is
# neither - so over plain HTTP every cookie the app sets would be silently
# dropped, and every sign-in test would fail for a reason nothing in the
# application's logs explains.
#
# The certificate is issued up front by scripts/prepare-certs.sh rather than by
# Caddy's own `tls internal`. The application fetches its own API over this URL
# during server rendering, so the Node process has to trust the certificate as
# well - and a CA that Caddy only creates once it starts does not exist yet when
# the application reads NODE_EXTRA_CA_CERTS. Issuing it first makes the trust
# chain explicit and removes the ordering problem.
#
# The browsers do not need the CA: every session is created with
# acceptInsecureCerts, which is the W3C-standard way to skip validation and,
# unlike Chrome's --unsafely-treat-insecure-origin-as-secure, behaves the same
# on Chrome, Firefox and Edge.

{
	# Nothing here reconfigures Caddy at run time, so the admin API stays shut.
	admin off
	# No ACME: this hostname is not on the internet and there is nothing to
	# renew against.
	auto_https disable_redirects
}

artra.test, localhost {
	tls /certs/server.crt /certs/server.key

	# Websockets go through the same directive - Caddy forwards the Upgrade
	# handshake with no extra configuration. Artra's /ws router rejects any
	# connection whose Origin is not VITE_URL, so the two must agree on this
	# hostname.
	reverse_proxy artra:3000 {
		header_up X-Forwarded-Proto https
	}

	log {
		output stdout
		format console
	}
}
